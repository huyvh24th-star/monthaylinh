@model Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container py-5" style="min-height:80vh;display:flex;align-items:center;">
    <div class="row justify-content-center w-100">
        <div class="col-md-5">
            <div class="auth-card p-5">
                <div class="text-center mb-4">
                    <div style="width:60px;height:60px;background:var(--accent-color);border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                        <i class="fa-solid fa-car-side text-white fs-4"></i>
                    </div>
                    <h2 class="auth-title">Đăng nhập</h2>
                    <p class="text-muted small">Chào mừng trở lại AutoMotiv</p>
                </div>
                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label small fw-bold text-muted text-uppercase" style="font-size:0.72rem;letter-spacing:0.08em;"></label>
                        <input asp-for="Username" class="form-control auth-input" placeholder="Tên đăng nhập">
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label small fw-bold text-muted text-uppercase" style="font-size:0.72rem;letter-spacing:0.08em;"></label>
                        <input asp-for="Password" type="password" class="form-control auth-input" placeholder="Mật khẩu">
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold" style="text-transform:uppercase;letter-spacing:0.08em;">
                        Đăng nhập
                    </button>
                </form>
                <div class="text-center mt-4">
                    <p class="text-muted small">Chưa có tài khoản? <a asp-controller="Account" asp-action="Register" style="color:var(--accent-color);font-weight:700;">Đăng ký ngay</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
