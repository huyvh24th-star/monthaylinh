@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<!-- Cart Sidebar -->
<div id="cart-sidebar" class="cart-sidebar shadow-2xl">
    <div class="p-4 d-flex justify-content-between align-items-center" style="background:var(--primary-color);color:white;">
        <h4 class="mb-0 fw-bold text-uppercase" style="font-family:'Barlow Condensed',sans-serif;letter-spacing:0.06em;font-size:1.3rem;">
            <i class="fa-solid fa-car me-2" style="color:var(--accent-color);"></i>Đơn đặt xe
        </h4>
        <button class="btn-close btn-close-white shadow-none" id="cart-close-btn"></button>
    </div>

    <!-- Cart Items -->
    <div id="cart-items" class="p-3 flex-grow-1 overflow-auto"></div>

    <div class="p-4 border-top bg-light-warm">
        <div class="mb-3">
            <label class="form-label small fw-bold text-muted text-uppercase" style="letter-spacing:0.08em;font-size:0.72rem;">Tên người mua</label>
            <input type="text" id="cart-receiver-name" class="form-control auth-input" placeholder="Nhập họ và tên...">
        </div>
        <div class="mb-3">
            <label class="form-label small fw-bold text-muted text-uppercase" style="letter-spacing:0.08em;font-size:0.72rem;">Số điện thoại</label>
            <input type="text" id="cart-phone" class="form-control auth-input" placeholder="Số điện thoại liên hệ...">
        </div>
        <div class="mb-4">
            <label class="form-label small fw-bold text-muted text-uppercase" style="letter-spacing:0.08em;font-size:0.72rem;">Địa chỉ giao xe</label>
            <textarea id="cart-address" class="form-control auth-input" rows="2" placeholder="Số nhà, tên đường, quận/huyện..."></textarea>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded-3" style="background:white;border:2px solid rgba(230,57,70,0.15);">
            <span class="fw-bold text-muted text-uppercase" style="font-size:0.78rem;letter-spacing:0.06em;">Tổng cộng:</span>
            <span id="cart-total" class="fw-bold fs-4" style="color:var(--accent-color);">0đ</span>
        </div>
        <button class="btn btn-primary w-100 fw-bold shadow-lg" id="checkout-btn"
                style="padding:1rem 2rem;font-size:1rem;border-radius:6px;text-transform:uppercase;letter-spacing:0.08em;transition:transform 0.1s;">
            <i class="fa-solid fa-paper-plane me-2"></i>Xác nhận đặt xe
        </button>
        <p class="text-center text-muted mt-2 mb-0" style="font-size:0.72rem;">
            <i class="fa-solid fa-shield-check me-1 text-success"></i>Bảo mật · Giao xe tận nơi · Hỗ trợ 24/7
        </p>
        <input type="hidden" name="__RequestVerificationToken" value="@tokens.RequestToken" id="cart-csrf-token">
    </div>
</div>
<div id="cart-overlay" class="cart-overlay"></div>
