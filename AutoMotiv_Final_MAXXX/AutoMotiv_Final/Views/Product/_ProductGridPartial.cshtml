@model List<ProductViewModel>

@foreach (var p in Model)
{
    <div class="col-md-4 col-lg-3 animate__animated animate__fadeInUp">
        <div class="product-card h-100">
            <div class="product-img-wrapper">
                <img src="@(p.Image ?? "https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?q=80&w=600&auto=format&fit=crop")" class="product-img" alt="@p.Name">
                <div class="product-badge">@p.Type</div>
            </div>
            <div class="card-body p-3">
                <h5 class="fw-bold mb-1" style="font-size:0.95rem;">
                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="text-decoration-none text-dark">@p.Name</a>
                </h5>
                <p class="text-muted small mb-3 line-clamp-2" style="font-size:0.8rem;">@(p.Description ?? "Liên hệ để được tư vấn chi tiết về mẫu xe này.")</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="product-price">@p.FormattedPrice</span>
                    @if (p.Stock > 0)
                    {
                        <button class="btn btn-primary rounded-pill px-3 py-1 add-to-cart-btn"
                                data-product-id="@p.Id"
                                data-product-name="@p.Name"
                                data-product-price="@p.Price"
                                data-product-image="@(p.Image ?? "")"
                                style="font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;"
                                title="Đặt mua">
                            <i class="fa-solid fa-plus me-1"></i>Đặt mua
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill" style="font-size:0.72rem;">Đã bán</span>
                    }
                </div>
            </div>
            <div class="car-specs">
                <div class="car-spec-item"><i class="fa-solid fa-gas-pump"></i> Xăng</div>
                <div class="car-spec-item"><i class="fa-solid fa-gear"></i> Tự động</div>
                <div class="car-spec-item"><i class="fa-solid fa-road"></i> 2024</div>
            </div>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="col-12 text-center py-5 text-muted">
        <i class="fa-solid fa-car opacity-25 mb-3" style="font-size: 3rem;"></i>
        <p>Không tìm thấy xe phù hợp.</p>
    </div>
}
