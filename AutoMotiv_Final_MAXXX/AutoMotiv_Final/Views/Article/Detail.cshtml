@model ArticleViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div style="background:var(--primary-color);padding:40px 0 30px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.5);text-decoration:none;">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Article" asp-action="Index" style="color:rgba(255,255,255,0.5);text-decoration:none;">Tin tức</a></li>
                <li class="breadcrumb-item active" style="color:white;">@Model.Title</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5" style="max-width:860px;">
    <span class="product-badge mb-3 d-inline-block" style="position:relative;top:auto;left:auto;border-radius:4px;">@Model.Category</span>
    <h1 class="section-title mb-3" style="font-size:2.25rem;">@Model.Title</h1>
    <div class="text-muted small mb-4"><i class="fa-regular fa-calendar me-1"></i>@Model.CreatedDate.ToString("dd/MM/yyyy")</div>
    @if (!string.IsNullOrEmpty(Model.Image))
    {
        <img src="@Model.Image" class="img-fluid rounded-3 mb-4 w-100" style="max-height:400px;object-fit:cover;" alt="@Model.Title">
    }
    <div class="article-content" style="line-height:1.9;font-size:1.05rem;">@Html.Raw(Model.Content)</div>
</div>
