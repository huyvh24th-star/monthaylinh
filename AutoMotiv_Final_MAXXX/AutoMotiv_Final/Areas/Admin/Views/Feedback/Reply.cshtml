@model FeedbackAdminReplyViewModel
@{ ViewData["Title"] = "Trả lời phản hồi"; }

<div class="page-header">
    <div class="breadcrumb-simple">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a> /
        <a asp-area="Admin" asp-controller="Feedback" asp-action="Index">Phản hồi</a> /
        Trả lời #@Model.FeedbackId
    </div>
    <div class="d-flex align-items-center gap-3 mt-1">
        <a asp-area="Admin" asp-controller="Feedback" asp-action="Detail" asp-route-id="@Model.FeedbackId"
           class="btn btn-outline-secondary btn-sm px-3">
            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
        </a>
        <h1 class="page-title mb-0">Trả lời phản hồi #@Model.FeedbackId</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="acard">
            <div class="acard-header"><span class="acard-title"><i class="fa-solid fa-reply me-2"></i>Nội dung trả lời</span></div>
            <div class="acard-body">
                <form asp-area="Admin" asp-controller="Feedback" asp-action="ReplyConfirmed" asp-route-id="@Model.FeedbackId" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="FeedbackId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="AdminReply" class="form-label">Nội dung trả lời</label>
                        <textarea asp-for="AdminReply" class="form-control" rows="7"
                                  placeholder="Nhập nội dung trả lời gửi đến khách hàng..."></textarea>
                        <span asp-validation-for="AdminReply" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa-solid fa-paper-plane me-2"></i>Gửi trả lời
                        </button>
                        <a asp-area="Admin" asp-controller="Feedback" asp-action="Index"
                           class="btn btn-outline-secondary px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
