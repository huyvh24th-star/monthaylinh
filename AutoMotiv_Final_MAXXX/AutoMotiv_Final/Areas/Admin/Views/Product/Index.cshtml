@model List<ProductAdminListViewModel>
@{ ViewData["Title"] = "Kho xe"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="breadcrumb-simple"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a> / Kho xe</div>
        <h1 class="page-title">Kho xe</h1>
    </div>
    <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-primary px-4">
        <i class="fa-solid fa-plus me-2"></i>Thêm xe
    </a>
</div>

<div class="acard">
    <div class="table-toolbar">
        <div class="table-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="searchInput" type="text" placeholder="Tìm tên xe, loại...">
        </div>
        <span class="text-muted" style="font-size:.78rem;">@Model.Count mẫu xe</span>
    </div>
    <div class="atable-wrap">
        <table class="atable" id="mainTable">
            <thead>
                <tr>
                    <th style="width:44px;">#</th>
                    <th>Tên xe</th>
                    <th>Loại</th>
                    <th>Giá niêm yết</th>
                    <th>Tồn kho</th>
                    <th>Nổi bật</th>
                    <th>Ngày tạo</th>
                    <th style="width:90px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8"><div class="empty-state"><i class="fa-solid fa-car-burst"></i><p>Chưa có xe nào trong kho</p></div></td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold text-muted" style="font-size:.78rem;">@p.Id</td>
                        <td>
                            <span class="fw-semibold" style="font-size:.875rem;">@p.Name</span>
                        </td>
                        <td><span class="badge-pill badge-info">@p.Type</span></td>
                        <td><span class="fw-bold" style="color:var(--ap);font-size:.85rem;">@p.Price.ToString("#,##0")đ</span></td>
                        <td>
                            @if (p.Stock <= 2)
                            {
                                <span class="badge-pill badge-danger">@p.Stock</span>
                            }
                            else if (p.Stock <= 5)
                            {
                                <span class="badge-pill badge-warning">@p.Stock</span>
                            }
                            else
                            {
                                <span class="badge-pill badge-success">@p.Stock</span>
                            }
                        </td>
                        <td>
                            @if (p.Featured)
                            {
                                <i class="fa-solid fa-star" style="color:#f59e0b;"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star" style="color:#d1d5db;"></i>
                            }
                        </td>
                        <td><span style="font-size:.78rem;color:#9ca3af;">@p.CreatedDate.ToString("dd/MM/yyyy")</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@p.Id"
                                   class="act-btn act-btn-edit" title="Sửa"><i class="fa-solid fa-pen"></i></a>
                                <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@p.Id"
                                   class="act-btn act-btn-del" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>initTableSearch('searchInput','mainTable');</script>
}
