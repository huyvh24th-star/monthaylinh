@model ProductAdminEditViewModel
@{
    ViewData["Title"] = "Thêm xe mới";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
        <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
    </a>
    <h2 class="section-title mb-0">Thêm xe mới</h2>
</div>

<div class="admin-card p-4" style="max-width: 700px;">
    <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold">Tên xe</label>
            <input asp-for="Name" class="form-control" placeholder="Ví dụ: Toyota Camry 2.5Q 2024" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold">Mô tả xe</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Thông tin động cơ, hộp số, tính năng nổi bật..."></textarea>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Price" class="form-label fw-semibold">Giá bán (VNĐ)</label>
                <input asp-for="Price" class="form-control" type="number" min="0" step="1000000" placeholder="0" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Stock" class="form-label fw-semibold">Số xe trong kho</label>
                <input asp-for="Stock" class="form-control" type="number" min="0" placeholder="0" />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label fw-semibold">Phân khúc xe</label>
            <select asp-for="Type" class="form-select">
                <option value="">-- Chọn phân khúc --</option>
                <option value="Sedan">Sedan</option>
                <option value="SUV">SUV</option>
                <option value="MPV">MPV</option>
                <option value="Hatchback">Hatchback</option>
                <option value="Pickup">Pickup</option>
                <option value="Crossover">Crossover</option>
                <option value="Điện">Xe điện</option>
            </select>
            <span asp-validation-for="Type" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ImageFile" class="form-label fw-semibold">Ảnh xe</label>
            <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
            <small class="text-muted">Định dạng: jpg, jpeg, png, webp, gif. Tối đa 5MB.</small>
        </div>

        <div class="mb-4">
            <div class="form-check form-switch">
                <input asp-for="Featured" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="Featured" class="form-check-label fw-semibold">Xe nổi bật (hiển thị trang chủ)</label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="fa-solid fa-save me-2"></i>Lưu xe
            </button>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
