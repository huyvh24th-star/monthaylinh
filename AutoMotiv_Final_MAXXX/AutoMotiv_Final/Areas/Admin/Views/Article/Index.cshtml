@model List<ArticleAdminListViewModel>
@{ ViewData["Title"] = "Bài viết"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="breadcrumb-simple"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a> / Bài viết</div>
        <h1 class="page-title">Bài viết &amp; Tin tức</h1>
    </div>
    <a asp-area="Admin" asp-controller="Article" asp-action="Create" class="btn btn-primary px-4">
        <i class="fa-solid fa-plus me-2"></i>Thêm bài viết
    </a>
</div>

<div class="acard">
    <div class="table-toolbar">
        <div class="table-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="searchInput" type="text" placeholder="Tìm tiêu đề, danh mục...">
        </div>
        <span class="text-muted" style="font-size:.78rem;">@Model.Count bài viết</span>
    </div>
    <div class="atable-wrap">
        <table class="atable" id="mainTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tiêu đề</th>
                    <th>Danh mục</th>
                    <th>Ngày đăng</th>
                    <th style="width:70px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5"><div class="empty-state"><i class="fa-solid fa-newspaper"></i><p>Chưa có bài viết nào</p></div></td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="fw-semibold text-muted" style="font-size:.78rem;">@a.Id</td>
                        <td style="font-size:.875rem;font-weight:500;max-width:320px;">@a.Title</td>
                        <td><span class="badge-pill badge-purple">@a.Category</span></td>
                        <td><span style="font-size:.78rem;color:#9ca3af;">@a.CreatedDate.ToString("dd/MM/yyyy")</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-area="Admin" asp-controller="Article" asp-action="Edit" asp-route-id="@a.Id"
                                   class="act-btn act-btn-edit" title="Sửa"><i class="fa-solid fa-pen"></i></a>
                                <a asp-area="Admin" asp-controller="Article" asp-action="Delete" asp-route-id="@a.Id"
                                   class="act-btn act-btn-del" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>initTableSearch('searchInput','mainTable');</script>
}
