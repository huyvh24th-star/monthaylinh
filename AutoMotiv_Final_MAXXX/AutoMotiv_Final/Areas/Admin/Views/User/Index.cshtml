@model List<UserAdminListViewModel>
@{ ViewData["Title"] = "Khách hàng"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="breadcrumb-simple"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a> / Khách hàng</div>
        <h1 class="page-title">Khách hàng</h1>
    </div>
    <span class="text-muted" style="font-size:.83rem;">@Model.Count người dùng</span>
</div>

<div class="acard">
    <div class="table-toolbar">
        <div class="table-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="searchInput" type="text" placeholder="Tìm tên, email...">
        </div>
        <div class="d-flex gap-2">
            <span class="badge-pill badge-danger" style="font-size:.78rem;">@Model.Count(u => u.Role == "Admin") Admin</span>
            <span class="badge-pill badge-info" style="font-size:.78rem;">@Model.Count(u => u.Role != "Admin") Khách hàng</span>
        </div>
    </div>
    <div class="atable-wrap">
        <table class="atable" id="mainTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Người dùng</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Ngày tạo</th>
                    <th style="width:60px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold text-muted" style="font-size:.78rem;">@u.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="av" style="background:@(u.Role == "Admin" ? "#ef4444" : "var(--ap)");font-size:.65rem;">
                                    @u.Username.Substring(0,1).ToUpper()
                                </div>
                                <div>
                                    <div style="font-size:.85rem;font-weight:600;">@u.Username</div>
                                    @if (!string.IsNullOrEmpty(u.FullName))
                                    {
                                        <div style="font-size:.72rem;color:#9ca3af;">@u.FullName</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td style="font-size:.83rem;">@(u.Email ?? "—")</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge-pill badge-danger">Admin</span>
                            }
                            else
                            {
                                <span class="badge-pill badge-info">Khách hàng</span>
                            }
                        </td>
                        <td><span style="font-size:.78rem;color:#9ca3af;">@u.CreatedDate.ToString("dd/MM/yyyy")</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@u.Id"
                                   class="act-btn act-btn-edit" title="Sửa"><i class="fa-solid fa-pen"></i></a>
                                @if (u.Role != "Admin")
                                {
                                    <form asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@u.Id"
                                          method="post" onsubmit="return confirm('Xóa người dùng @u.Username?')" style="display:contents;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="act-btn act-btn-del" title="Xóa"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>initTableSearch('searchInput','mainTable');</script>
}
